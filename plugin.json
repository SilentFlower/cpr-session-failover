{
  "manifestVersion": 2,
  "publisher": "silentflower",
  "name": "session-failover",
  "displayName": "会话排队迁移",
  "version": "0.3.1",
  "description": "严格会话绑定下限时等待、换号改绑与切换记录",
  "license": "Apache-2.0",
  "engines": { "codex-proxy-rs": ">=3.41.0" },
  "main": "bin/cpr-session-failover",
  "runtime": "trustedProcess",
  "resources": {
    "LICENSE": "text/plain",
    "NOTICE": "text/plain",
    "THIRD_PARTY_LICENSES.txt": "text/plain",
    "web/index.html": "text/html",
    "web/app.js": "application/javascript",
    "web/app.css": "text/css"
  },
  "contributes": {
    "middleware": { "version": 6, "stages": ["request", "attempt"], "inputFormats": ["openai"], "outputFormats": ["openai"] },
    "scheduler": { "version": 3 },
    "management": { "version": 2 },
    "command_line": {},
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "waitSeconds": { "type": "integer", "title": "迁移等待阈值（秒）", "description": "从首次选号计算持续等待，必须小于本体最终排队超时", "minimum": 1, "maximum": 110, "default": 15 }
    },
    "additionalProperties": false,
    "patternProperties": { "^historyLimit$": { "type": "integer" } }
  },
  "state": [
    { "namespace": "audit", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 1, "maximumBytes": 262144, "maximumValueBytes": 262144, "migratesFrom": [] },
    { "namespace": "history", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 10000, "maximumBytes": 16777216, "maximumValueBytes": 262144, "migratesFrom": [] }
  ]
}
